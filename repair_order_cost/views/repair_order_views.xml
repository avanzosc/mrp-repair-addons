<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_repair_order_form" model="ir.ui.view">
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='move_ids']/list//field[@name='product_uom']"
        position="after"
      >
        <field
          name="material_cost"
          groups="repair_order_cost.group_show_repair_order_cost"
        />
      </xpath>
      <notebook position="before">
        <group
          colspan="4"
          col="6"
          groups="repair_order_cost.group_show_repair_order_cost"
        >
          <field name="material_cost" />
          <field name="operations_cost" />
          <field name="total_repair_cost" />
        </group>
      </notebook>
    </field>
  </record>

  <record id="view_repair_order_form_inherit" model="ir.ui.view">
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair_service.view_repair_order_form_inherit" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='repair_service_ids']/list//field[@name='product_uom_qty']"
        position="after"
      >
        <field
          name="operations_cost"
          groups="repair_order_cost.group_show_repair_order_cost"
        />
      </xpath>
    </field>
  </record>

  <record id="view_repair_order_tree" model="ir.ui.view">
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_tree" />
    <field name="arch" type="xml">
      <field name="product_uom" position="after">
        <field
          name="material_cost"
          groups="repair_order_cost.group_show_repair_order_cost"
          optional="show"
          sum="Total material cost"
        />
        <field
          name="operations_cost"
          groups="repair_order_cost.group_show_repair_order_cost"
          optional="show"
          sum="Total operations cost"
        />
        <field
          name="total_repair_cost"
          groups="repair_order_cost.group_show_repair_order_cost"
          optional="show"
          sum="Total cost"
        />
      </field>
    </field>
  </record>
</odoo>
