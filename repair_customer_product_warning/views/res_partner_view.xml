<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="inside">
                <group
          groups="repair_customer_product_warning.group_warning_repair"
          col="2"
        >
                    <separator string="Warning on the Repair Order" colspan="2" />
                    <field name="repair_warn" nolabel="1" colspan="2" required="1" />
                    <field
            name="repair_warn_msg"
            placeholder="Type a message..."
            nolabel="1"
            colspan="2"
            attrs="{
                               'required': [('repair_warn','!=', False), ('repair_warn','!=','no-message')],
                               'invisible': [('repair_warn','in', (False, 'no-message'))]
                           }"
          />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
