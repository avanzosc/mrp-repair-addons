<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="account_invoice_section_repair.res_config_settings_view_form"
    />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='repair_account_div']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="repair_warnings">
                    <div class="o_setting_left_pane">
                        <field name="group_warning_repair" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_warning_repair" string="Repair Warnings" />
                        <div class="text-muted">
                            Get warnings in repairs for parts, operations or customers
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
