<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="repair_type_view_form" model="ir.ui.view">
        <field name="model">repair.type</field>
        <field name="inherit_id" ref="repair_type.repair_type_view_form" />
        <field name="arch" type="xml">
            <field name="source_location_add_part_id" position="attributes">
                <attribute name="domain">[('eligible_for_repairs','=',True)]</attribute>
            </field>
            <field name="source_location_remove_part_id" position="attributes">
                <attribute name="domain">[('eligible_for_repairs','=',True)]</attribute>
            </field>
        </field>
    </record>
 </odoo>
