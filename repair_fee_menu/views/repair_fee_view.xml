<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="repair_fee_search_view" model="ir.ui.view">
        <field name="model">repair.fee</field>
        <field name="arch" type="xml">
            <search>
                <field name="repair_id" />
                <field name="product_id" />
                <group expand="0" string="Group By">
                    <filter
            name="product"
            string="Product"
            domain="[]"
            context="{'group_by': 'product_id'}"
          />
                    <filter
            name="repair_order"
            string="Repair Order"
            domain="[]"
            context="{'group_by': 'repair_id'}"
          />
                    <filter
            name="repair_state"
            string="Repair State"
            domain="[]"
            context="{'group_by': 'repair_state'}"
          />
                    <filter
            name="repair_create_date"
            string="Repair Create Date"
            domain="[]"
            context="{'group_by': 'repair_create_date'}"
          />
                </group>
            </search>
        </field>
    </record>
    <record id="repair_fee_tree_view" model="ir.ui.view">
        <field name="model">repair.fee</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="repair_create_date" />
                <field name="repair_id" />
                <field name="repair_state" widget="badge" />
                <field name="product_id" />
                <field name="name" optional="show" />
                <field name="product_uom_qty" string="Quantity" />
                <field
          name="product_uom"
          string="UoM"
          groups="uom.group_uom"
          optional="show"
        />
                <field name="price_unit" optional="show" />
                <field name="tax_id" widget="many2many_tags" optional="show" />
                <field
          name="price_subtotal"
          widget="monetary"
          groups="account.group_show_line_subtotals_tax_excluded"
        />
                <field
          name="price_total"
          widget="monetary"
          groups="account.group_show_line_subtotals_tax_included"
        />
                <field name="currency_id" invisible="1" />
                <field name="company_id" invisible="1" force_save="1" />
            </tree>
        </field>
    </record>

    <record id="repair_fee_pivot_view" model="ir.ui.view">
        <field name="model">repair.fee</field>
        <field name="arch" type="xml">
            <pivot string="Repair Fees Analysis">
                <field name="price_subtotal" type="measure" />
                <field name="price_total" type="measure" />
                <field name="product_id" type="row" />
            </pivot>
        </field>
    </record>

    <record id="action_repair_fee_menu" model="ir.actions.act_window">
        <field name="name">Repair Fees</field>
        <field name="res_model">repair.fee</field>
        <field name="view_mode">tree,pivot</field>
    </record>

    <menuitem
    id="repair_fee_menu"
    name="Repair Fees"
    parent="repair.repair_menu_reporting"
    action="action_repair_fee_menu"
    sequence="30"
  />

</odoo>
