<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="crm_case_claims_form_view" model="ir.ui.view">
    <field name="inherit_id" ref="crm_claim_links.crm_case_claims_form_view" />
    <field name="model">crm.claim</field>
    <field name="arch" type="xml">
      <button name="action_view_repairs" position="after">
        <button
          name="action_view_productions"
          type="object"
          class="oe_stat_button"
          invisible="production_count == 0"
          icon="fa-tasks"
        >
          <field name="production_count" widget="statinfo" string="MOs" />
        </button>
      </button>
    </field>
  </record>
</odoo>
