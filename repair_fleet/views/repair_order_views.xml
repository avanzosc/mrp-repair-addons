<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="repair_order_form_vehicle_patch" model="ir.ui.view">
    <field name="name">repair.order.form.vehicle.patch</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//sheet//field[@name='lot_id']" position="attributes">
        <attribute name="string">Lot/serial number (license plate)</attribute>
      </xpath>
      <xpath expr="//sheet//field[@name='product_id']" position="attributes">
        <attribute name="domain">[('categ_id.repairable','=',True)]</attribute>
      </xpath>

      <xpath
        expr="//sheet//group/group[2]//field[@name='currency_id']"
        position="after"
      >
        <separator string="Vehicle" />
        <group>
          <field name="vehicle_id" />
          <field name="vehicle_license_plate" readonly="1" />
          <field name="vehicle_brand" readonly="1" />
          <field name="vehicle_model" readonly="1" />
          <field name="vehicle_vin" readonly="1" />
          <field name="odometer_km" />
          <field name="fuel_level" />
        </group>
      </xpath>
    </field>
  </record>
</odoo>
