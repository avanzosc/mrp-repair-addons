<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <!-- Operations table: show the repair order when the MO has one. -->
  <record id="mrp_production_workorder_tree_editable_view" model="ir.ui.view">
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="repair_id" optional="show" readonly="1" />
      </field>
    </field>
  </record>

  <!-- Operation times table: show the repair order when the work order has one. -->
  <record id="mrp_production_workorder_form_view_inherit" model="ir.ui.view">
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='time_ids']/list/field[@name='loss_id']"
        position="after"
      >
        <field name="repair_id" optional="show" readonly="1" />
      </xpath>
    </field>
  </record>

  <!-- Productivity (OEE) report list. -->
  <record id="oee_tree_view" model="ir.ui.view">
    <field name="model">mrp.workcenter.productivity</field>
    <field name="inherit_id" ref="mrp.oee_tree_view" />
    <field name="arch" type="xml">
      <field name="workcenter_id" position="after">
        <field name="repair_id" optional="show" readonly="1" />
      </field>
    </field>
  </record>
</odoo>
