<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_repair_close" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='sale_management']" position="inside">
                <h2>Repair Order from Sale</h2>
                <div
          class="row mt16 o_settings_container"
          name="repair_close_manual_setting_container"
        >
                    <div class="col-12 col-lg-6 o_setting_box" id="repair_close_manual">
                        <div class="o_setting_left_pane">
                            <field name="repair_close_manual" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="repair_close_manual" />
                            <div class="text-muted">
                                This checked means you must close manually the repair order.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
